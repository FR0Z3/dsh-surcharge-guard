{
  "name": "dsh-surcharge-guard",
  "version": "0.1.0",
  "description": "Estimate long-context surcharge risk and compact history near per-model thresholds in DeepSeek Harness.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context",
    "billing"
  ],
  "homepage": "https://github.com/GT-610/dsh-surcharge-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GT-610/dsh-surcharge-guard.git"
  },
  "bugs": "https://github.com/GT-610/dsh-surcharge-guard/issues",
  "author": "GT610 (https://github.com/GT-610)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./logic": "./logic.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "logic.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "tsc -p tsconfig.json && node scripts/build.mjs && node --check index.js && node --check logic.js && node --check client.js && node scripts/check-locale.mjs && node --test \"tests/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4 || >=3.18.5-alpha.1 <4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/react": "^18.3.32",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    }
  }
}
